{
  "name": "negarin-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Build tooling for the Negarin WordPress + WooCommerce theme.",
  "scripts": {
    "dev": "node -e \"require('fs').writeFileSync('.vite-dev','1')\" && vite",
    "build": "node -e \"try{require('fs').unlinkSync('.vite-dev')}catch(e){}\" && vite build",
    "lint:css": "stylelint \"assets/css/**/*.css\""
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
  },
  "dependencies": {
    "@hotwired/turbo": "^8.0.23",
    "alpinejs": "^3.13.10"
  }
}
