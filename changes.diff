+ * `woocommerce_update_order_review_fragments` (that one's checkout-only,
+ * fired by WooCommerce core's own `update_checkout` jQuery event).
+ */
+add_filter(
+    'woocommerce_add_to_cart_fragments',
+    function ( $fragments ) {
